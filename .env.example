APP_NAME="Dyalog API GO"
APP_ENV=development
APP_PORT=8080
APP_VERSION=dev
APP_COMMIT=local
APP_BUILD_DATE=unknown
# Tag da imagem usada pelo docker-compose. Padrao latest. Para voltar a uma versao
# anterior, aponte para a tag datada correspondente (ex: 2026-09-18).
# DYALOG_IMAGE_TAG=latest
# Fuso horario usado por rotinas de horario fixo (ex: limpeza/compactacao diaria
# de webhook_entregas, as 4h da manha). A imagem Docker inclui tzdata; sem ele,
# TZ e ignorado silenciosamente e o processo cai em UTC.
# TZ=America/Manaus
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/dyalog.db
# Para Supabase/Postgres:
# DATABASE_DRIVER=postgres
# DATABASE_DSN=postgres://usuario:senha@host:5432/postgres?sslmode=require
# Alternativa compatível com compose/infra:
# DB_USER=postgres
# DB_PASSWORD=senha
# DB_NAME=dyalog-api
# DB_HOST=postgres
# DB_PORT=5432
# DB_SSLMODE=disable
# Store interno do whatsmeow. Padrao: sqlite por instancia em SESSION_STORAGE_DIR.
# Para usar o mesmo Postgres da aplicacao, defina WHATSAPP_STORE_DRIVER=postgres.
WHATSAPP_STORE_DRIVER=sqlite
# WHATSAPP_STORE_DSN=postgres://usuario:senha@host:5432/postgres?sslmode=require
SESSION_STORAGE_DIR=./data/sessoes
SESSION_DEVICE_NAME=DyalogAPI
SESSION_CLIENT_TYPE=chrome
SESSION_PAIRING_DISPLAY_NAME=Chrome (Windows)
TEMP_FILES_DIR=./data/temp
HTTP_LOG_MODE=falhas
WHATSAPP_LOG_LEVEL=ERROR
WEBHOOK_URL=
WEBHOOK_MAX_ATTEMPTS=60
WEBHOOK_RETRY_BASE_SECONDS=30
WEBHOOK_RETRY_MAX_DURATION_HOURS=24
WEBHOOK_RETRY_MAX_INTERVAL_MINUTES=30
WEBHOOK_WORKER_BATCH_SIZE=25
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_WORKER_CONCURRENCY=5
# Quantos dias manter no Postgres o historico de entregas ja finalizadas
# (entregues ou esgotadas) em webhook_entregas antes de apagar automaticamente.
# O payload guardado inclui o corpo inteiro do evento (com base64 de midia,
# quando houver), entao essa tabela cresce rapido sem essa limpeza.
WEBHOOK_ENTREGA_RETENTION_DAYS=30
# Opcional em multi-container. Se vazio, usa hostname do container.
# RUNTIME_NODE_ID=dyalog-api-1
# Endereco pelo qual as outras replicas alcancam ESTE container (nao use o VIP do
# servico, que balancearia de volta). Se ficar vazio, a API detecta sozinha o IP da
# rede overlay. So preencha se a deteccao automatica escolher a interface errada.
# RUNTIME_NODE_ADDRESS=http://10.0.1.15:8080
RUNTIME_LOCK_TTL_SECONDS=90
RUNTIME_HEARTBEAT_INTERVAL_SECONDS=30
# Frequencia com que a API verifica instancias caidas e reconecta as que ainda
# tem sessao valida. Nao afeta instancias que dependem de QR code ou login novo.
INSTANCE_RECONNECT_INTERVAL_SECONDS=30
WEBHOOK_RECOVERY_ENABLED=true
WEBHOOK_RECOVERY_MARGIN_SECONDS=120
WEBHOOK_RECOVERY_HISTORY_COUNT=50
MEDIA_STORAGE_DRIVER=local
# Para enviar midias recebidas tambem ao Supabase Storage:
# MEDIA_STORAGE_DRIVER=supabase
# MEDIA_STORAGE_SUPABASE_URL=https://seu-projeto.supabase.co
# MEDIA_STORAGE_SUPABASE_KEY=service-role-ou-chave-com-permissao-storage
# MEDIA_STORAGE_SUPABASE_BUCKET=dyalog-midias
# MEDIA_STORAGE_PUBLIC_BASE_URL=https://seu-projeto.supabase.co/storage/v1/object/public/dyalog-midias
UPDATE_MONITORING_ENABLED=true
UPDATE_MODE=aviso
UPDATE_WINDOW_START=01:00
UPDATE_WINDOW_END=02:00
UPDATE_INTERVAL_MINUTES=30
UPDATE_APPLY_ENABLED=false
UPDATE_APPLY_TOKEN=
UPDATE_PROXY_URL=https://proxy.golang.org
UPDATE_ARTIFACTS_DIR=./data/updates
DASHBOARD_MASTER_TOKEN=seu-token-master
DASHBOARD_COOKIE_NAME=dyalog_dashboard_token
API_BASE_URL=http://localhost:8080
HISTORY_MAX_DAYS=90
